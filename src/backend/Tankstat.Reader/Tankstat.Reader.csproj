<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decoding, orienting and preparing photos for the OCR; the build without Fontconfig keeps the image's dependencies small. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tankstat.Reader.Core\Tankstat.Reader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tankstat.Reader.IntegrationTests" />
  </ItemGroup>

  <!-- Fonts for the synthetic photos (SIL OFL 1.1); their licences travel with the published reader. -->
  <ItemGroup>
    <EmbeddedResource Include="third_party\fonts\*.ttf" LogicalName="Tankstat.Reader.Fonts.%(Filename)%(Extension)" />
    <None Include="third_party\fonts\*.txt;third_party\fonts\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
