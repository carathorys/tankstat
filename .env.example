# Copy to .env next to docker-compose.example.yml and fill in the passwords and addresses below (the first administrator is made
# on the setup page, at the first visit):
#   cp .env.example .env
# A strong random password:  openssl rand -base64 24

# The Tankstat release to run: 0.17 follows 0.17.x (the patches), 0.17.0 stays on that one, and "latest" moves on with every
# stable release. A new minor version can have upgrade steps: read the Upgrading section of its changelog before you change this.
TANKSTAT_VERSION=0.17

# The database password (only the app uses it; PostgreSQL takes it on its first start, so change it later in the database too).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# The address people reach the app at (password links in e-mails are built from it): http://localhost:8080 on this machine,
# or the HTTPS address of the reverse proxy in front of it.
PUBLIC_URL=http://localhost:8080

# Only for a real mail server instead of Mailpit (the Smtp__Username/Password lines in the compose file).
# SMTP_PASSWORD=
